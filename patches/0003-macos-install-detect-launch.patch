new file mode 100644
index 0000000..eb6a6e6
--- /dev/null
+++ b/src/electron/mac/mac-paths.ts
@@ -0,0 +1,50 @@
+import os from 'node:os';
+import path from 'node:path';
+
+/**
+ * macOS build only (not part of the upstream Hub): the Hub's detection, launch, update and
+ * uninstall logic is written for Windows paths (`path.win32`, `C:\…\App.exe`, uninstall command
+ * lines). Rather than fork that logic, the macOS adapters present each installed bundle as a
+ * virtual Windows install on a drive that cannot exist on a Mac, and translate back at the edge:
+ *
+ *   /Applications/Nebula Clock.app/Contents/MacOS/Nebula Clock
+ *   <-> M:\Applications\Nebula Clock.app\Contents\MacOS\Nebula Clock.exe
+ */
+export const VIRTUAL_DRIVE = 'M:';
+
+/** Folders where a Nebula app may be installed, most common first. */
+export function applicationDirs(): string[] {
+  return ['/Applications', path.join(os.homedir(), 'Applications')];
+}
+
+/** Only bundles of the family are ever listed, replaced or removed. */
+export const NEBULA_BUNDLE = /^Nebula [A-Za-z0-9][A-Za-z0-9 ._-]{0,60}\.app$/;
+export const SAFE_PRODUCT_NAME = /^Nebula [A-Za-z0-9][A-Za-z0-9 ._-]{0,60}$/;
+
+export function toVirtual(realPath: string): string {
+  return `${VIRTUAL_DRIVE}${realPath.split('/').join('\\')}`;
+}
+
+/** The real path behind a virtual one, or null when the path is not virtual. */
+export function toReal(virtualPath: string): string | null {
+  if (!virtualPath.toUpperCase().startsWith(`${VIRTUAL_DRIVE}\\`) || virtualPath.includes('..')) return null;
+  return virtualPath.slice(VIRTUAL_DRIVE.length).split('\\').join('/');
+}
+
+/** `…/X.app/Contents/MacOS/X.exe` (virtual) -> the real executable, without the `.exe`. */
+export function realExecutable(virtualPath: string): string | null {
+  const real = toReal(virtualPath);
+  return real ? real.replace(/\.exe$/i, '') : null;
+}
+
+/**
+ * The bundle (`/Applications/Nebula X.app`) a real path belongs to, only when it is a family
+ * bundle directly inside one of the application folders. Null otherwise: nothing else is touched.
+ */
+export function bundleOf(realPath: string): string | null {
+  const index = realPath.indexOf('.app/');
+  const bundle = index < 0 ? (realPath.endsWith('.app') ? realPath : null) : realPath.slice(0, index + 4);
+  if (!bundle) return null;
+  const folder = path.dirname(bundle);
+  return applicationDirs().includes(folder) && NEBULA_BUNDLE.test(path.basename(bundle)) ? bundle : null;
+}
diff --git a/src/electron/mac/mac-probe.ts b/src/electron/mac/mac-probe.ts
new file mode 100644
index 0000000..af909ff
--- /dev/null
+++ b/src/electron/mac/mac-probe.ts
@@ -0,0 +1,127 @@
+import { execFile } from 'node:child_process';
+import fs from 'node:fs/promises';
+import path from 'node:path';
+import type { SystemProbe } from '../apps/system-probe';
+import { applicationDirs, bundleOf, NEBULA_BUNDLE, realExecutable, SAFE_PRODUCT_NAME, toVirtual } from './mac-paths';
+
+/**
+ * macOS build only (not part of the upstream Hub): what `windowsProbe` asks Windows, asked to
+ * macOS instead, through execFile with argument arrays only (R11).
+ *
+ * The installed apps are the family bundles found in /Applications and ~/Applications. They are
+ * handed to the unchanged detection code as the text of a registry export (one Uninstall entry
+ * per bundle, on the virtual drive of mac-paths.ts), so matching, version reading, launch checks
+ * and the uninstall command validation all run exactly as on Windows.
+ */
+const UNINSTALL_KEY = 'HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall';
+
+function run(command: string, args: string[], timeout: number): Promise<string> {
+  return new Promise((resolve, reject) => {
+    execFile(command, args, { timeout, maxBuffer: 8 * 1024 * 1024, encoding: 'utf8' }, (error, stdout) => {
+      if (error) reject(error);
+      else resolve(String(stdout));
+    });
+  });
+}
+
+/** A .reg string: backslashes and quotes escaped. */
+function regQuote(value: string): string {
+  return `"${value.replace(/\\/g, '\\\\').replace(/"/g, '\\"')}"`;
+}
+
+interface Bundle {
+  name: string;
+  version: string;
+  executableDir: string;
+}
+
+async function familyBundles(): Promise<Bundle[]> {
+  const bundles: Bundle[] = [];
+  for (const dir of applicationDirs()) {
+    let names: string[];
+    try {
+      names = await fs.readdir(dir);
+    } catch {
+      continue;
+    }
+    for (const file of names.filter((name) => NEBULA_BUNDLE.test(name)).sort()) {
+      const name = file.slice(0, -'.app'.length);
+      const bundle = path.join(dir, file);
+      const executableDir = path.join(bundle, 'Contents', 'MacOS');
+      try {
+        if (!(await fs.stat(path.join(executableDir, name))).isFile()) continue;
+        const version = (await run('/usr/bin/plutil', ['-extract', 'CFBundleShortVersionString', 'raw', '-o', '-', path.join(bundle, 'Contents', 'Info.plist')], 5000)).trim();
+        bundles.push({ name, version, executableDir });
+      } catch {
+        // Not a complete bundle (a copy in progress, a broken install): not installed.
+      }
+    }
+  }
+  return bundles;
+}
+
+export const macProbe: SystemProbe = {
+  async exportRegistry(key) {
+    if (key !== UNINSTALL_KEY) return null;
+    const lines = ['Windows Registry Editor Version 5.00', ''];
+    for (const bundle of await familyBundles()) {
+      const uninstaller = toVirtual(path.join(bundle.executableDir, `Uninstall ${bundle.name}.exe`));
+      const keyName = `mac-${toVirtual(bundle.executableDir).replace(/[^A-Za-z0-9]+/g, '-')}`;
+      lines.push(
+        `[HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\${keyName}]`,
+        `"DisplayName"=${regQuote(`${bundle.name} ${bundle.version}`)}`,
+        `"DisplayVersion"=${regQuote(bundle.version)}`,
+        `"UninstallString"=${regQuote(`"${uninstaller}" /S`)}`,
+        '',
+      );
+    }
+    return lines.join('\r\n');
+  },
+
+  async runningProcesses() {
+    try {
+      const names = new Set<string>();
+      for (const line of (await run('/bin/ps', ['-axo', 'comm='], 10_000)).split('\n')) {
+        // The main executable of a bundle, not its helpers (…/Frameworks/… Helper.app/…).
+        const match = /\/([^/]+)\.app\/Contents\/MacOS\/([^/]+)$/.exec(line.trim());
+        if (match && match[1] === match[2] && !line.includes('/Frameworks/')) names.add(`${match[2].toLowerCase()}.exe`);
+      }
+      return names;
+    } catch {
+      return new Set();
+    }
+  },
+
+  async fileExists(filePath) {
+    const real = realExecutable(filePath);
+    if (!real) return false;
+    try {
+      return (await fs.stat(real)).isFile();
+    } catch {
+      return false;
+    }
+  },
+
+  async requestClose(exeName) {
+    // The polite request (R08): the same "quit" the user would choose in the app's own menu.
+    const name = exeName.replace(/\.exe$/i, '');
+    if (!SAFE_PRODUCT_NAME.test(name)) return;
+    await run('/usr/bin/osascript', ['-e', `tell application "${name}" to quit`], 10_000).catch(() => undefined);
+  },
+
+  async forceClose(exeName) {
+    const name = exeName.replace(/\.exe$/i, '');
+    if (!SAFE_PRODUCT_NAME.test(name)) return;
+    // The app and its helper processes (pkill reports an error when nothing matches).
+    await run('/usr/bin/pkill', ['-f', `/${name.replace(/[.]/g, '\\.')}\\.app/Contents/`], 10_000).catch(() => undefined);
+  },
+
+  async start(executable, _workingDirectory, args = []) {
+    const real = realExecutable(executable);
+    const bundle = real ? bundleOf(real) : null;
+    if (!bundle) throw new Error('ERR_NOT_A_NEBULA_BUNDLE');
+    // -n: a new instance, which hands its arguments to the running one (single-instance lock),
+    // like starting the .exe a second time on Windows.
+    await run('/usr/bin/open', ['-n', '-a', bundle, ...(args.length > 0 ? ['--args', ...args] : [])], 15_000);
+  },
+};
