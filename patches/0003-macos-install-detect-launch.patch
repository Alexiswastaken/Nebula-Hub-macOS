new file mode 100644
index 0000000..b48c562
--- /dev/null
+++ b/src/electron/mac/platform.ts
@@ -0,0 +1,42 @@
+import { windowsProbe } from '../apps/system-probe';
+import type { SystemProbe } from '../apps/system-probe';
+import { CATALOG_PUBLIC_KEY as UPSTREAM_CATALOG_PUBLIC_KEY } from '../catalog-key';
+import { launchDetached as launchDetachedOnWindows, spawnInstallerRunner, type InstallerRunner } from '../install/installer-runner';
+import { IS_MAC_BUILD } from '../../shared/mac-build';
+import { macInstallerRunner } from './mac-installer';
+import { macProbe } from './mac-probe';
+
+/**
+ * macOS build only (not part of the upstream Hub): the single place where the Hub picks its
+ * platform adapters. On Windows and Linux every export is exactly the upstream object.
+ *
+ * On macOS the apps come from the macOS builds of the family (Alexiswastaken/<App>-macOS), listed
+ * by a catalog of the same schema, signed with its own Ed25519 key (R03 unchanged: an invalid
+ * signature is refused). The upstream catalog, signed with the upstream key, lists Windows
+ * installers only and is not accepted by a macOS build.
+ */
+const MAC_CATALOG_PUBLIC_KEY = `-----BEGIN PUBLIC KEY-----
+MCowBQYDK2VwAyEAIoZpWZRGbnu+G/I8YnLEdHkvMF7MDOC8hdxRnl7IQL4=
+-----END PUBLIC KEY-----
+`;
+
+const MAC_CATALOG_BASE = 'https://raw.githubusercontent.com/Alexiswastaken/Nebula-Hub-macOS/main/catalog/';
+
+export const systemProbe: SystemProbe = IS_MAC_BUILD ? macProbe : windowsProbe;
+
+export const installerRunner: InstallerRunner = IS_MAC_BUILD ? macInstallerRunner : spawnInstallerRunner;
+
+/** The Hub does not replace itself on macOS: its own macOS release is installed by hand. */
+export const launchDetached: typeof launchDetachedOnWindows = IS_MAC_BUILD
+  ? () => Promise.reject(Object.assign(new Error('the Hub does not update itself on macOS'), { code: 'ENOTSUP' }))
+  : launchDetachedOnWindows;
+
+export const CATALOG_PUBLIC_KEY = IS_MAC_BUILD ? MAC_CATALOG_PUBLIC_KEY : UPSTREAM_CATALOG_PUBLIC_KEY;
+
+/** Where the catalog is read: the macOS catalog on a Mac, the upstream sources elsewhere. */
+export function catalogSources<T extends { id: 'raw' | 'release'; catalogUrl: string; signatureUrl: string }>(upstream: T[]): T[] {
+  if (!IS_MAC_BUILD) return upstream;
+  return upstream
+    .filter((source) => source.id === 'raw')
+    .map((source) => ({ ...source, catalogUrl: `${MAC_CATALOG_BASE}nebula-catalog.json`, signatureUrl: `${MAC_CATALOG_BASE}nebula-catalog.json.sig` }));
+}
