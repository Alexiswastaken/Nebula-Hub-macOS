diff --git a/src/shared/mac-build.ts b/src/shared/mac-build.ts
new file mode 100644
index 0000000..8f50825
--- /dev/null
+++ b/src/shared/mac-build.ts
@@ -0,0 +1,12 @@
+/**
+ * macOS build only (not part of the upstream Hub): true in the main process of a Hub running on
+ * macOS. False on Windows and Linux, in the renderer (no `process` there), and under Jest, whose
+ * suites describe the Windows behaviour whatever machine runs them.
+ */
+export const IS_MAC_BUILD = typeof process !== 'undefined' && process.platform === 'darwin' && process.env.JEST_WORKER_ID === undefined;
+
+/** The macOS installer of a release for this Mac: the `.dmg` built for its processor. */
+export function isMacInstallerName(name: string): boolean {
+  const lower = name.toLowerCase();
+  return lower.endsWith('.dmg') && lower.includes(`-${process.arch}.`);
+}
