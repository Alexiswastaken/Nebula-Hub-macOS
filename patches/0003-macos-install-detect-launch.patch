diff --git a/src/electron/mac/mac-installer.ts b/src/electron/mac/mac-installer.ts
new file mode 100644
index 0000000..490abc1
--- /dev/null
+++ b/src/electron/mac/mac-installer.ts
@@ -0,0 +1,124 @@
+import { execFile, spawn } from 'node:child_process';
+import fs from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import type { InstallerResult, InstallerRunner } from '../install/installer-runner';
+import { applicationDirs, bundleOf, NEBULA_BUNDLE, realExecutable, toReal } from './mac-paths';
+
+/**
+ * macOS build only (not part of the upstream Hub): the three things the install manager runs,
+ * done the macOS way, without a shell (R11).
+ *
+ * - A verified `.dmg` (size and SHA-512 already checked against the release feed, R02): mounted
+ *   read-only and hidden, its single family bundle copied next to the previous one, then swapped
+ *   in. The app's data (~/Library/Application Support) is never touched.
+ * - The virtual uninstaller of mac-probe.ts (`…\Uninstall <App>.exe`): removes that bundle, and
+ *   only a family bundle directly inside an application folder.
+ * - The app's own executable (its backup before an update or an uninstall): started as is.
+ */
+function run(command: string, args: string[], timeout: number): Promise<void> {
+  return new Promise((resolve, reject) => {
+    execFile(command, args, { timeout, maxBuffer: 4 * 1024 * 1024 }, (error) => (error ? reject(error) : resolve()));
+  });
+}
+
+async function writable(dir: string): Promise<boolean> {
+  try {
+    await fs.access(dir, fs.constants.W_OK);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+async function exists(target: string): Promise<boolean> {
+  try {
+    await fs.stat(target);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+/** Where the bundle goes: where it already is, else /Applications, else ~/Applications. */
+async function destination(bundleName: string): Promise<string> {
+  const dirs = applicationDirs();
+  for (const dir of dirs) {
+    if ((await exists(path.join(dir, bundleName))) && (await writable(dir))) return path.join(dir, bundleName);
+  }
+  for (const dir of dirs) {
+    await fs.mkdir(dir, { recursive: true }).catch(() => undefined);
+    if (await writable(dir)) return path.join(dir, bundleName);
+  }
+  throw Object.assign(new Error('no writable application folder'), { code: 'EACCES' });
+}
+
+async function installDiskImage(image: string): Promise<void> {
+  const mount = await fs.mkdtemp(path.join(os.tmpdir(), 'nebula-hub-dmg-'));
+  let attached = false;
+  try {
+    await run('/usr/bin/hdiutil', ['attach', image, '-nobrowse', '-readonly', '-noautoopen', '-mountpoint', mount], 120_000);
+    attached = true;
+    const bundles = (await fs.readdir(mount)).filter((name) => NEBULA_BUNDLE.test(name));
+    if (bundles.length !== 1) throw Object.assign(new Error('expected exactly one Nebula bundle in the disk image'), { code: 'EBUNDLE' });
+    const target = await destination(bundles[0]);
+    const staging = `${target}.installing`;
+    await fs.rm(staging, { recursive: true, force: true });
+    // ditto keeps the bundle's symlinks, permissions and extended attributes.
+    await run('/usr/bin/ditto', [path.join(mount, bundles[0]), staging], 300_000);
+    await fs.rm(target, { recursive: true, force: true });
+    await fs.rename(staging, target);
+  } finally {
+    if (attached) await run('/usr/bin/hdiutil', ['detach', mount, '-force'], 60_000).catch(() => undefined);
+    await fs.rm(mount, { recursive: true, force: true }).catch(() => undefined);
+  }
+}
+
+async function removeBundle(realUninstaller: string): Promise<void> {
+  const bundle = bundleOf(realUninstaller);
+  if (!bundle) throw Object.assign(new Error('not a Nebula bundle'), { code: 'EBUNDLE' });
+  await fs.rm(bundle, { recursive: true, force: true });
+}
+
+function runExecutable(executable: string, args: readonly string[]): Promise<number | null> {
+  return new Promise((resolve, reject) => {
+    const child = spawn(executable, [...args], { shell: false, stdio: 'ignore' });
+    child.once('error', reject);
+    child.once('exit', (code) => resolve(code));
+  });
+}
+
+async function perform(installer: string, args: readonly string[]): Promise<InstallerResult> {
+  if (installer.toLowerCase().endsWith('.dmg') && path.isAbsolute(installer)) {
+    await installDiskImage(installer);
+    return { kind: 'exit', code: 0 };
+  }
+  const real = toReal(installer);
+  if (!real) throw Object.assign(new Error('unsupported installer'), { code: 'ENOTSUP' });
+  if (/^Uninstall .+\.exe$/i.test(path.basename(real))) {
+    await removeBundle(real);
+    return { kind: 'exit', code: 0 };
+  }
+  const executable = realExecutable(installer);
+  if (!executable || !bundleOf(executable)) throw Object.assign(new Error('not a Nebula bundle'), { code: 'EBUNDLE' });
+  return { kind: 'exit', code: await runExecutable(executable, args) };
+}
+
+export const macInstallerRunner: InstallerRunner = {
+  run(installer, args, timeoutMs) {
+    return new Promise((resolve, reject) => {
+      // Like the Windows runner: past the limit the Hub stops waiting, the work is not interrupted.
+      const timer = setTimeout(() => resolve({ kind: 'timeout' }), timeoutMs);
+      perform(installer, args).then(
+        (result) => {
+          clearTimeout(timer);
+          resolve(result);
+        },
+        (error) => {
+          clearTimeout(timer);
+          reject(error);
+        },
+      );
+    });
+  },
+};
